# Required: Qwen Cloud API key (Alibaba Cloud Model Studio / DashScope).
# Create one at https://modelstudio.console.alibabacloud.com/apiKey —
# the app calls the OpenAI-compatible endpoint
# (https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: Other LLM providers (if switching from Qwen)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: Alpha Vantage for additional market data
# ALPHA_VANTAGE_API_KEY=

# DhanHQ / NSE ----------------------------------------------------------------
# Market data source: DhanHQ API (replaces Yahoo Finance)
# Requires a DhanHQ Data APIs subscription (₹499 or ₹999/month)
# 
# Setup:
# 1. Subscribe at https://dhan.co for Data APIs
# 2. Create an API app at My Profile → Access DhanHQ APIs
# 3. Fill in credentials below
#
# The app auto-logs in using PIN + TOTP — no browser login needed.
# Access token is refreshed automatically each day.
#
# Never paste credentials into source code or command-line arguments, and
# never commit them.
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Symbol list CSV — single source of truth for all stock symbols
# Format: one column "symbol" with ticker symbols
DHAN_SYMBOLS_FILE=./config/symbols.csv

# Browser session authentication
# Local mode is open by default when no browser-auth secret is configured, so a
# fresh clone can open without a login or a credential in `.env`. To protect a
# local instance, set `TRADINGAGENTS_LOCAL_AUTH_SECRET`; the login page accepts
# that value as the password/secret. You may instead configure both
# `TRADINGAGENTS_AUTH_USERNAME` and `TRADINGAGENTS_AUTH_PASSWORD`.
#
# Before exposing the app publicly, set `TRADINGAGENTS_AUTH_MODE=public`,
# `FRONTEND_URL` to the exact HTTPS frontend origin, and an explicit username and
# password. Public/production mode always requires authentication and fails
# closed when those credentials or the frontend URL are missing. The Dhan
# integration is read-only and order execution is not exposed by this
# application.
TRADINGAGENTS_AUTH_MODE=local
# TRADINGAGENTS_LOCAL_AUTH_SECRET=choose-a-local-secret
# Optional explicit local username/password contract:
# TRADINGAGENTS_AUTH_USERNAME=local-user
# TRADINGAGENTS_AUTH_PASSWORD=change-this-password

# Open mode (no login) only answers requests addressed to localhost/127.0.0.1.
# Add other host names if you reach the backend another way, e.g. a LAN IP
# (then also add that frontend origin to CORS_ORIGINS):
# TRADINGAGENTS_ALLOWED_HOSTS=192.168.1.20

# Max paid AI analyses one backtest may run (default 60)
# TRADINGAGENTS_MAX_BACKTEST_DATES=60

# CLI only: fetch announcements from the upstream TradingAgents project (off by default)
# TRADINGAGENTS_CLI_ANNOUNCEMENTS=1

# Required for public/production mode. Never derive this from the Host header.
# TRADINGAGENTS_AUTH_MODE=public
# FRONTEND_URL=https://portfolio.example
# TRADINGAGENTS_AUTH_USERNAME=admin
# TRADINGAGENTS_AUTH_PASSWORD=change-this-public-password
